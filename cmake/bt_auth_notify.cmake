# Keep this adaptation limited to the missing Authentication Complete error
# notification. It does not change SDK reference ownership or disconnection.
function(ds5_patch_bt_auth source destination)
    file(READ "${source}" hci_source)
    string(FIND "${hci_source}" "static void auth_complete(" auth_start)
    string(FIND "${hci_source}" "static void read_remote_features_complete(" auth_end)
    if(auth_start LESS 0 OR auth_end LESS auth_start)
        message(FATAL_ERROR "Cannot locate SDK Authentication Complete handler")
    endif()
    math(EXPR auth_length "${auth_end} - ${auth_start}")
    string(SUBSTRING "${hci_source}" ${auth_start} ${auth_length} auth_body)
    set(notification "bt_conn_security_changed(conn, security_err_get(evt->status));")
    string(FIND "${auth_body}" "${notification}" notified)
    if(notified LESS 0)
        set(anchor "\t\treset_pairing(conn);")
        string(FIND "${auth_body}" "${anchor}" reset_at)
        if(reset_at LESS 0)
            message(FATAL_ERROR "SDK authentication handler changed; review notification patch")
        endif()
        string(REPLACE "${anchor}" "${anchor}\n\t\t${notification}" patched_auth "${auth_body}")
        string(REPLACE "${auth_body}" "${patched_auth}" hci_source "${hci_source}")
    endif()
    get_filename_component(output_dir "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${output_dir}")
    if(EXISTS "${destination}")
        file(READ "${destination}" previous)
        if(previous STREQUAL hci_source)
            return()
        endif()
    endif()
    file(WRITE "${destination}" "${hci_source}")
endfunction()

if(TARGET libblestack)
    set(ds5_hci_source "${BL_SDK_BASE}/components/wireless/bluetooth/blestack/src/host/hci_core.c")
    set(ds5_hci_patched "${CMAKE_CURRENT_BINARY_DIR}/generated/bt/hci_core.c")
    ds5_patch_bt_auth("${ds5_hci_source}" "${ds5_hci_patched}")
    get_target_property(ds5_bt_sources libblestack SOURCES)
    list(FIND ds5_bt_sources "${ds5_hci_source}" ds5_hci_index)
    if(ds5_hci_index LESS 0)
        message(FATAL_ERROR "Cannot replace SDK hci_core.c in libblestack")
    endif()
    list(REMOVE_AT ds5_bt_sources ${ds5_hci_index})
    list(APPEND ds5_bt_sources "${ds5_hci_patched}")
    set_property(TARGET libblestack PROPERTY SOURCES "${ds5_bt_sources}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ds5_hci_source}")
elseif(NOT CMAKE_SCRIPT_MODE_FILE)
    message(FATAL_ERROR "Bluetooth SDK target libblestack is required")
endif()
