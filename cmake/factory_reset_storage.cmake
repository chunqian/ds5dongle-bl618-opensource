# Add the small reset extension to a private SDK translation unit. The shared
# SDK stays untouched, and the extension uses the adapter's existing lock/FS.
function(ds5_extend_reset_storage source extension destination)
    file(READ "${source}" storage_source)
    foreach(anchor "static lfs_t *lfs" "static char path_buffer" "#define LFS_EF_NAMESPACE" "#define EF_GIANT_LOCK()")
        string(FIND "${storage_source}" "${anchor}" position)
        if(position LESS 0)
            message(FATAL_ERROR "LittleFS/EasyFlash adapter changed; review factory-reset extension (${anchor})")
        endif()
    endforeach()
    file(READ "${extension}" reset_source)
    string(APPEND storage_source "\n/* DS5Dongle factory-reset extension. */\n${reset_source}")
    get_filename_component(output_dir "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${output_dir}")
    if(EXISTS "${destination}")
        file(READ "${destination}" previous)
        if(previous STREQUAL storage_source)
            return()
        endif()
    endif()
    file(WRITE "${destination}" "${storage_source}")
endfunction()

if(TARGET liblittlefs)
    set(ds5_storage_source "${BL_SDK_BASE}/components/fs/littlefs/easyflash_port/lfs_easyflash.c")
    set(ds5_reset_extension "${CMAKE_CURRENT_LIST_DIR}/../src/factory_reset_storage.inc")
    set(ds5_storage_patched "${CMAKE_CURRENT_BINARY_DIR}/generated/storage/lfs_easyflash.c")
    ds5_extend_reset_storage("${ds5_storage_source}" "${ds5_reset_extension}" "${ds5_storage_patched}")
    get_target_property(ds5_storage_sources liblittlefs SOURCES)
    list(FIND ds5_storage_sources "${ds5_storage_source}" ds5_storage_index)
    if(ds5_storage_index LESS 0)
        message(FATAL_ERROR "Cannot replace SDK lfs_easyflash.c in liblittlefs")
    endif()
    list(REMOVE_AT ds5_storage_sources ${ds5_storage_index})
    list(APPEND ds5_storage_sources "${ds5_storage_patched}")
    set_property(TARGET liblittlefs PROPERTY SOURCES "${ds5_storage_sources}")
    target_include_directories(liblittlefs PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../src")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${ds5_storage_source}" "${ds5_reset_extension}")
elseif(NOT CMAKE_SCRIPT_MODE_FILE)
    message(FATAL_ERROR "LittleFS SDK target liblittlefs is required for factory reset")
endif()
